on boot
    chown system system /sys/class/power_supply/battery/batt_slate_mode
    chmod 0664 /sys/class/power_supply/battery/batt_slate_mode
    chown system system /sys/class/sec/afc/afc_disable
    chmod 0664 /sys/class/sec/afc/afc_disable
    chown system system /sys/class/sec/afc/afc_disable_val
    chmod 0664 /sys/class/sec/afc/afc_disable_val
