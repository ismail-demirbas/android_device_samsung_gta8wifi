cc_library_shared {
    name: "libui_shim_gta8wifi",
    srcs: ["shim/gbm_shim.cpp"],
    shared_libs: ["libui", "libcutils", "libutils", "android.hardware.graphics.common-V7-ndk"],
    vendor: true,
}

cc_library_shared {
    name: "libc2_shim_gta8wifi",
    srcs: ["shim/c2_shim.cpp"],
    shared_libs: ["libcodec2_vndk", "libcodec2_soft_common", "libutils", "libcutils", "liblog", "libhardware"],
    include_dirs: [
        "frameworks/av/media/codec2/vndk/include",
        "frameworks/av/media/codec2/core/include",
    ],
    compile_multilib: "64",
    vendor: true,
}

cc_library_shared {
    name: "libsec_ssl_shim",
    vendor: true,
    srcs: ["shim/ssl_compat.c"],
    shared_libs: ["libcrypto"],
}

cc_library_shared {
    name: "libsec_base_shim",
    vendor: true,
    srcs: ["shim/base_shim.cpp"],
    shared_libs: ["libbase"],
}

cc_library_shared {
    name: "libsec_ima_shim",
    vendor: true,
    srcs: ["shim/ima_mime.cpp"],
}

prebuilt_etc_xml {
    name: "gta8wifi_vendor_manifest.xml",
    owner: "samsung",
    src: "vintf/manifest.xml",
    filename_from_src: true,
    sub_dir: "vintf/manifest",
    soc_specific: true,
}

cc_library_shared {
    name: "libgb_new_shim_gta8wifi",
    srcs: ["shim/gb_new.c"],
    vendor: true,
    compile_multilib: "32",
    stl: "none",
    system_shared_libs: ["libc"],
}

prebuilt_etc {
    name: "afc_mode.rc",
    src: "afc_mode.rc",
    sub_dir: "init",
    system_ext_specific: true,
    filename_from_src: true,
}
