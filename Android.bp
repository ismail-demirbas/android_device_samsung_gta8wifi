soong_namespace {
    imports: [
        "vendor/samsung/gta8wifi",
    ],
}

install_symlink {
    name: "gta8wifi_symlink_firmware_audio_structure",
    soc_specific: true,
    installed_location: "firmware/audio_structure",
    symlink_target: "/data/vendor/local/media/audio_params/audio_structure",
}

install_symlink {
    name: "gta8wifi_symlink_firmware_cvs",
    soc_specific: true,
    installed_location: "firmware/cvs",
    symlink_target: "/data/vendor/local/media/audio_params/cvs",
}

